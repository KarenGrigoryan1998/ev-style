# Server-side secrets for the Meta Conversions API (api/meta-capi.ts).
# Copy to .env and fill in. On Vercel: Project → Settings → Environment Variables (same names).
# Never prefix these with VITE_ — that would put them in the public frontend code.
#
# Public IDs are NOT here — they go in src/config/site.ts → analytics:
#   metaPixelId (Meta Pixel), ga4Id (Google Analytics G-…), tiktokPixelId (TikTok Pixel)

# Events Manager → your Pixel → Settings → Conversions API → Generate access token
META_CAPI_TOKEN=

# Same Pixel ID as analytics.metaPixelId in src/config/site.ts
META_PIXEL_ID=

# ── Local only (photo import scripts, not needed on Vercel) ──
# Folder with your EVStyle photos. Default: ~/Documents/EVStyle
EVSTYLE_SRC=
